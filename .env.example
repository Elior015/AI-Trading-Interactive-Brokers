# Copy this file to .env and fill in real values. .env is gitignored — never
# commit it. In Docker, prefer the *_FILE variants / Docker secrets for
# TWS_PASSWORD instead of putting it in .env; see docker-compose.yml.

# --- Trading mode -----------------------------------------------------------
# The live-trading interlock requires THREE independent things to agree
# (see Settings.verify_live_interlock in src/aitrader/config.py):
#   1. TRADING_MODE=live
#   2. ALLOW_LIVE_TRADING=true
#   3. IB_ACCOUNT_ID matching the account IBKR actually reports
# Any disagreement aborts startup rather than continuing in an ambiguous
# state. Leave everything below at its default (paper) until you have run a
# long, unattended paper session and reviewed the results.
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false
IB_ACCOUNT_ID=

# --- IB Gateway credentials --------------------------------------------------
# The account that logs into IB Gateway / TWS. This is your regular IBKR
# username and password — the same one used for both paper and live trading
# (IBKR paper accounts share login credentials with the live account and are
# distinguished by the account ID prefix, DU/DF for paper).
TWS_USERID=
TWS_PASSWORD=

# --- Ollama --------------------------------------------------------------
# Create a key at https://ollama.com/settings/keys for the cloud provider.
# Leave blank if llm.provider is set to ollama_local in config.yaml.
OLLAMA_API_KEY=
# Optional override; normally derived from llm.provider in config.yaml.
OLLAMA_HOST=

# --- Misc --------------------------------------------------------------
LOG_LEVEL=INFO
# Path to an alternate config.yaml; leave blank to use config/config.yaml.
CONFIG_FILE=
